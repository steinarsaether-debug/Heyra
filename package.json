{
  "name": "heyra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:demo": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; node ./scripts/seed-demo-accounts.mjs'",
    "seed:demo:lite": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; node ./scripts/seed-demo-accounts.mjs --lite'",
    "seed:demo:reset": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; node ./scripts/seed-demo-accounts.mjs --reset'",
    "db:validate": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; prisma validate --schema prisma/schema.prisma'",
    "db:generate": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; prisma generate --schema prisma/schema.prisma'",
    "db:migrate:dev": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; prisma migrate dev --schema prisma/schema.prisma'",
    "db:migrate:deploy": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; prisma migrate deploy --schema prisma/schema.prisma'",
    "cwd:import": "sh -ac 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; node scripts/import-cwd-zones.mjs'"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "next-auth": "^4.24.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vitest": "^4.1.2"
  }
}
